# Strix follower LLM + budget config. Sourced by run_focused10_strix.sh
# before launch; override any default here. Also honours plain env-var
# overrides at launch time (`STRIX_MODE=deep ./run_focused10_strix.sh`).

# ─── LLM backend ────────────────────────────────────────────────────────
# Strix uses LiteLLM internally — same provider notation we do, but it
# does NOT have the azure_ai→openai shape retry our litellm_router added
# in bb07555, so Azure Foundry deployments must be reached via the
# OpenAI-compat path directly.
#
# Discovered via litellm_router's live retry: Azure Foundry resource at
# `rt3ai.services.ai.azure.com` responds to the OpenAI-compat shape
# `openai/<deployment>` with api_base = `<resource_root>/openai/v1`.
# All deployments on the resource (Flash, Pro, gpt-5-mini, …) answer on
# that same endpoint using the resource-level API key.
STRIX_LLM="openai/DeepSeek-V4-Pro"
OPENAI_API_BASE="https://rt3ai.services.ai.azure.com/openai/v1"

# Resource-level key for rt3ai Azure Foundry. Loaded from a local
# gitignored secrets file so the committed strix.env never carries a
# real key. Create strix_overnight/.secrets with:
#   LLM_API_KEY="<rt3ai Foundry resource key>"
# before launching the follower. The run script sources this file; if
# .secrets is missing, launch fails fast rather than silently misroute.
if [ -f "$(dirname "$BASH_SOURCE")/.secrets" ]; then
  # shellcheck disable=SC1091
  . "$(dirname "$BASH_SOURCE")/.secrets"
fi
export LLM_API_KEY="${LLM_API_KEY:-}"

# Alternative backends (uncomment one, replace the active block above):
#   STRIX_LLM=ollama/qwen3-coder:30b
#   OLLAMA_API_BASE=http://host.docker.internal:11434
#   LLM_API_KEY=sk-no-key-needed-for-local-ollama
#
#   STRIX_LLM=openai/DeepSeek-V4-Flash          # same endpoint, cheaper/faster
#   OPENAI_API_BASE=https://rt3ai.services.ai.azure.com/openai/v1

# ─── Budget caps (hard limits) ──────────────────────────────────────────
# A fair benchmark means both agents stop at the same spend. The lead
# (cvebench_overnight) runs max_iters=15 ≈ few cents on Azure.
# $1/CVE is a generous cap; adjust down for a tighter head-to-head.
STRIX_BUDGET="1.00"       # USD per CVE
STRIX_MAX_TURNS="50"      # agent turn cap per CVE
STRIX_MODE="quick"         # quick | standard | deep
