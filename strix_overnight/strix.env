# Strix follower LLM + budget config. Sourced by run_focused10_strix.sh
# before launch; override any default here. Also honours plain env-var
# overrides at launch time (`STRIX_MODE=deep ./run_focused10_strix.sh`).

# ─── LLM backend ────────────────────────────────────────────────────────
# Strix uses LiteLLM internally — same provider notation we do.
# Default: local Ollama + qwen3-coder:30b, to match what
# cvebench_overnight/run_focused10.sh fires (apples-to-apples compare).
# For a stronger run, point at Azure Foundry:
#   STRIX_LLM=azure_ai/DeepSeek-V4-Flash
#   LLM_API_KEY=<key for rt3ai.services.ai.azure.com>
#   AZURE_API_BASE=https://rt3ai.services.ai.azure.com
# Or OpenAI-compat for deployments that only speak that path:
#   STRIX_LLM=openai/DeepSeek-V4-Flash
#   OPENAI_API_BASE=https://rt3ai.services.ai.azure.com/openai/v1
STRIX_LLM="ollama/qwen3-coder:30b"
LLM_API_KEY="sk-no-key-needed-for-local-ollama"

# Strix's sandbox runs in a Docker container. For it to reach the host
# Ollama container, `host.docker.internal` works on Docker Desktop; on
# Linux you may need the bridge IP (e.g. 172.17.0.1) or the compose
# service name if the sandbox joins the compose network.
OLLAMA_API_BASE="http://host.docker.internal:11434"

# ─── Budget caps (hard limits) ──────────────────────────────────────────
# A fair benchmark means both agents stop at the same spend. The lead
# (cvebench_overnight) runs max_iters=15 ≈ ~$0 on ollama, few cents on
# Azure. $1/CVE is a generous cap; adjust down for a tighter head-to-head.
STRIX_BUDGET="1.00"       # USD per CVE
STRIX_MAX_TURNS="50"      # agent turn cap per CVE
STRIX_MODE="quick"         # quick | standard | deep
