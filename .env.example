# Docker Compose Profiles — controls which optional services start.
# "local-db" = local Postgres. Remove if using external/remote DB.
# Add "gpu" for Ollama, "vault" for Vault, "optional" for OpenWebUI/Kong.
COMPOSE_PROFILES=local-db

API_KEY=changeme
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=scans
POSTGRES_HOST=rag-postgres
POSTGRES_PORT=5432
DB_DSN=postgresql://app:app@rag-postgres:5432/scans

# Database Role Passwords (multi-database setup)
# N8N_PASSWORD=changeme
# EXPLOITDB_PASSWORD=changeme
# SCANS_PASSWORD=changeme
EDB_RW_PASSWORD=changeme

# ZAP
ZAP_API_KEY=changeme
ZAP_ADDR=zap
ZAP_PORT=8090

# Chisel Tunnel
CHISEL_USER=pentest
CHISEL_PASSWORD=changeme

# Metasploit RPC
# WARNING: MSF_RPC_USER / MSF_RPC_PASS are read by TWO services that must agree —
# the `metasploit` container starts msfrpcd with them, and `exploit-runner`
# authenticates with them. After changing either value you must RECREATE
# metasploit, not just restart it: the msfrpcd command line is fixed at container
# creation, so a restart keeps the old credential.
#
#   docker compose up -d --force-recreate --no-deps metasploit exploit-runner
#
# A mismatch is easy to misdiagnose. msfrpcd answers "Login Failed", but the
# failure surfaces downstream as "Invalid Authentication Token" and /msf/jobs +
# /msf/sessions return HTTP 500. See Docs/SECURITY_SETUP.md.
MSF_RPC_USER=msf
MSF_RPC_PASS=msf
MSF_RPC_HOST=metasploit
MSF_RPC_PORT=55553
MSF_LHOST=
MSF_LPORT=4444

# API / Nmap
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
NMAP_PORT_BATCH=100
NMAP_OUT_DIR=/app/nmap_out
NMAP_SERVICE_DETECTION=1
NMAP_VERSION_INTENSITY=9
# Basic scripts (default):
NMAP_SCRIPTS=banner,http-title,ssl-cert,ssl-enum-ciphers,ssh2-enum-algos
# Extended scripts (uncomment for service enumeration):
# NMAP_SCRIPTS=banner,http-title,http-methods,http-server-header,ssl-cert,ssl-enum-ciphers,ssh2-enum-algos,smtp-commands,smtp-enum-users,smtp-open-relay,smb-enum-shares,smb-os-discovery,ftp-anon,snmp-sysdescr,ldap-search

# Web scanner
WORDLIST=/opt/seclists/Discovery/Web-Content/DirBuster-2007_directory-list-2.3-medium.txt
WEB_PORTS=80,443,8080,8443,8000,8888,3000,5000
DEEP_SCAN_PORTS=1-65535
SCHEME_HINT=auto

# Nuclei
NUCLEI_SEVERITY=medium,high,critical
NUCLEI_CONCURRENCY=50
NUCLEI_RATELIMIT=150
NUCLEI_TIMEOUT=10
NUCLEI_RETRIES=1
NUCLEI_AUTO_UPDATE=1

# Playwright Scanner
BROWSER_TYPE=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
USER_AGENT=Mozilla/5.0 (Playwright Security Scanner)
USE_ZAP=true
HEADLESS=true
SCREENSHOT_FORMAT=png

# LLM Backend: "ollama" (default), "vllm", "azure", "openai", or "anthropic"
LLM_BACKEND=ollama

# Ollama LLM
# Windows WSL2: use --profile gpu to start Docker ollama with NVIDIA GPU
# macOS: copy .env.mac.example — uses native Ollama via host.docker.internal
# OLLAMA_URL=http://ollama:11434          # Windows (default, Docker container)
# OLLAMA_URL=http://host.docker.internal:11434  # macOS (native Ollama)
OLLAMA_MODEL=qwen2.5:32b
OLLAMA_TIMEOUT=300

# vLLM (when LLM_BACKEND=vllm)
# VLLM_URL=http://vllm:8000
# VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# VLLM_API_KEY=changeme

# Azure AI Foundry / Azure OpenAI (when LLM_BACKEND=azure)
# AZURE_API_KEY=your-api-key
# AZURE_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_MODEL=gpt-4o
# AZURE_API_VERSION=2024-08-01-preview
# AZURE_EMBED_MODEL=text-embedding-3-small

# OpenAI (when LLM_BACKEND=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_API_BASE=https://api.openai.com

# Anthropic (when LLM_BACKEND=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Autogen Multi-Agent System
# Uses OLLAMA_MODEL, API_KEY, and DB_DSN from above
# Agent coordination for automated penetration testing
AUTO_EXECUTE_SAFE=1

# OSINT / External API Keys
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
PDCP_API_KEY=

# SSH Tunnel (outbound autossh to remote VPS/jumpbox)
# Start: docker compose --profile ssh-tunnel up -d ssh-tunnel
# SSH_REMOTE_HOST=your-vps-ip
# SSH_REMOTE_USER=root
# SSH_REMOTE_PORT=22
# SSH_MODE=dynamic
# SSH_SOCKS_PORT=1080
# SSH_REVERSE_BIND=0.0.0.0:9999
# SSH_REVERSE_TARGET=pentest-dashboard:80
# SSH_LOCAL_PORT=3389
# SSH_LOCAL_TARGET=127.0.0.1:3389
# SSH_KEY_PATH=./ssh-keys
# SSH_KEY_NAME=id_rsa
# SSH_EXTRA_OPTS=

# Open WebUI (optional)
# OLLAMA_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=
# OPENAI_API_KEY=

# W&B for GRPO training (optional)
# WANDB_API_KEY=

# Remote DB via WireGuard (used with docker-compose.remote-db.yml)
# See Docs/REMOTE-DB-SETUP.md for full guide
# WG_SERVER_IP=10.13.13.1
# WG_SERVER_PUBLIC_IP=
# REMOTE_DB_PORT=5432
# REMOTE_DB_USER=app
# REMOTE_DB_PASSWORD=

# Timezone - all containers use Eastern Time
TZ=America/New_York

# ──────────────────────────────────────────────────────────
# HashiCorp Vault (optional — `--profile vault`)
# Set VAULT_ADDR after running:
#   docker compose --profile vault up -d
#   ./scripts/vault-seed.sh
# ──────────────────────────────────────────────────────────
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_SKIP_VERIFY=true
VAULT_PORT=8200

# ──────────────────────────────────────────────────────────
# Rate limiting on rag-api (empty disables)
# ──────────────────────────────────────────────────────────
RATE_LIMIT=120/minute

# ──────────────────────────────────────────────────────────
# Scan timeouts (seconds). Per-job payload + admin app_settings beat these.
# ──────────────────────────────────────────────────────────
NMAP_TIMEOUT_FALLBACK=1800
NMAP_TIMEOUT_PROXIED=3600
NMAP_TIMEOUT_SERVICE=600
NMAP_TIMEOUT_UDP=1800
NMAP_TIMEOUT_SMB=300
NMAP_TIMEOUT_RESUME=7200
INGEST_TIMEOUT=600
INGEST_TIMEOUT_SHORT=300
SCAN_TIMEOUT_CACHE_TTL=60
STALE_JOB_TIMEOUT_HOURS=24
MAX_CONCURRENT_SCANS=5
MAX_PIPELINE_CONCURRENT=20
PIPELINE_POLL_INTERVAL=5
RECON_AGENT_BASE_INTERVAL=30

# ──────────────────────────────────────────────────────────
# AI agent orchestration engine (Docs/LANGGRAPH_MIGRATION_PLAN.md)
# ──────────────────────────────────────────────────────────
# langgraph = deterministic StateGraph + durable Postgres checkpoints (DEFAULT
#             as of migration Phase 4). Recon/scan/analyze run as LLM agents
#             over the same scope-gated tool bodies AutoGen used.
# autogen   = the legacy GroupChat. Kept as the fallback for one release; set
#             this to fall the whole stack back.
# A single session can be pinned to either engine without a restart:
#   POST /pentest {"engine": "autogen"}   (canary / A-B comparison)
# Embedding backend for scan-recommender's RAG (/rag/ask, /rag/ingest).
# Resolved SEPARATELY from LLM_BACKEND — the chat model and the embedding model
# are different services (DeepSeek chats but does not embed).
#   auto     = Azure if AZURE_EMBED_MODEL is set, else the embedder service,
#              else ollama  (recommended)
#   embedder = the app/embedder sentence-transformers service (384-d MiniLM)
#   azure    = needs AZURE_ENDPOINT + AZURE_API_KEY + AZURE_EMBED_MODEL
#   ollama   = needs a reachable OLLAMA_HOST serving EMBED_MODEL (768-d nomic)
# Switching backends changes the vector dimension; the service reconciles the
# pgvector column automatically ONLY while the corpus is empty, and otherwise
# tells you to re-ingest rather than dropping your data.
EMBED_BACKEND=auto
EMBEDDER_URL=https://embedder:8030

AGENT_ENGINE=langgraph
# LangGraph exploit phase. Off by default: with it on a session PAUSES at
# status='awaiting_approval' until an operator answers
# POST /pentest/{id}/approve, so enabling it stack-wide parks unattended
# sessions. Prefer per-session {"enable_exploit_phase": true}.
LANGGRAPH_EXPLOIT_PHASE=false

# ──────────────────────────────────────────────────────────
# Container resource limits (per-service overrides commented)
# ──────────────────────────────────────────────────────────
DEFAULT_MEM_LIMIT=4g
DEFAULT_CPUS=2.0
# RAG_API_MEM_LIMIT=6g
# RAG_API_CPUS=4.0
# AUTOGEN_MEM_LIMIT=6g
# AUTOGEN_CPUS=3.0
# EMBEDDER_MEM_LIMIT=8g
# EMBEDDER_CPUS=4.0
# VAULT_MEM_LIMIT=512m

# ──────────────────────────────────────────────────────────
# DB connection pool (rag-api)
# ──────────────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=40

# ──────────────────────────────────────────────────────────
# BFF outbound HTTP timeout tiers (seconds)
# ──────────────────────────────────────────────────────────
TIMEOUT_FAST=3
TIMEOUT_NORMAL=15
TIMEOUT_LONG=60
TIMEOUT_SCAN=300
TIMEOUT_LLM=600

# ──────────────────────────────────────────────────────────
# LLM tuning (anti-hallucination defaults; override via Settings → LLM Tuning)
# These are compile-time defaults; per-session values stored in app_settings
# take precedence (loaded with 60s cache).
# ──────────────────────────────────────────────────────────
# LLM_TEMPERATURE=0.3
# LLM_TOP_P=0.85
# LLM_TOP_K=40
# LLM_REPEAT_PENALTY=1.1
# LLM_NUM_CTX=8192
# LLM_NUM_PREDICT=4096
# LLM_SEED=0

# JVM max heap for ZAP. MUST stay meaningfully under ZAP_MEM_LIMIT: zap.sh reads
# the container limit from the cgroup **v1** path only, so on a cgroup v2 host it
# falls back to HOST memory and picks a heap far larger than the container allows.
ZAP_JVM_HEAP=3g

# Container memory cap for ZAP. Must stay meaningfully ABOVE ZAP_JVM_HEAP: -Xmx
# caps the heap, not the process — ZAP's non-heap overhead (metaspace, thread
# stacks, native buffers) is ~900MB. Measured at 3g heap under a 4g limit: 97.5%
# and still climbing during an active scan, i.e. one spike from an OOM kill.
ZAP_MEM_LIMIT=6g

# ── ZAP passive-scan tuning ──────────────────────────────────────────────────
# The passive scanner runs every enabled rule against EVERY message ZAP sees, on
# a bounded thread pool fed by an UNBOUNDED queue holding whole HTTP messages.
# One slow rule therefore GROWS MEMORY rather than costing time.
#
# Measured on demo.testfire.net: 327 "Passive Scan rule ... took N seconds"
# warnings, every one naming "Tech Detection Passive Scanner" (the wappalyzer
# add-on) at 40-51s each. Raising the heap 3g -> 8g did NOT fix it: ZAP grew to
# 11.98 GiB and died at the same point. Do not reach for more memory first.
#
# That rule has NO rule id and cannot be disabled by id — its add-on registers it
# directly, so it never appears in pscan/view/scanners. Pausing passive scanning
# for the active scan is the lever that reaches it while keeping the add-on (and
# technology fingerprinting) installed. Crawl findings are unaffected: they are
# already banked by the post-spider drain before the pause begins.
ZAP_PSCAN_DURING_ACTIVE_SCAN=false
# Passive-scan only in-context messages. ZAP's own default is false, i.e. it
# passive-scans third-party resources the target merely links to.
ZAP_PSCAN_ONLY_IN_SCOPE=true
# Cap alerts retained per rule. 0 = unlimited (ZAP's default).
ZAP_MAX_ALERTS_PER_RULE=0
# CSV of passive rule ids to disable, e.g. "10096,10027". Validated against ZAP's
# registry — an id ZAP does not know is reported, never silently ignored.
ZAP_DISABLE_PSCAN_RULES=
# Seconds between mid-scan finding saves, so a ZAP death costs one interval
# rather than every finding in the run.
ZAP_DRAIN_INTERVAL=60

# ── ZAP active-scanner bounds ────────────────────────────────────────────────
# ZAP ships the active scanner UNBOUNDED in all three dimensions that matter:
# 64 threads per host, no per-rule time limit, no per-scan time limit. One rule
# that misbehaves therefore misbehaves 64 times at once, for as long as it likes.
#
# Measured: with wappalyzer gone the crawl held flat at 2.335 GiB for eight
# minutes, then DomXssScanRule started and memory went 2.34 -> 11.93 GiB in 78
# seconds. That rule launches Firefox through Selenium, so 64 threads meant up to
# 64 concurrent browser launches, each failing ("failed to start browser:
# JdkWebSocket initial request execution error") and retrying. It then logged
# "skipped plugin" — ~10 GiB spent to deliver nothing.
#
# The rule-duration bound is the GENERAL one: capping threads fixes that rule,
# capping per-rule runtime stops whichever rule runs away next.
ZAP_THREAD_PER_HOST=8
ZAP_MAX_RULE_DURATION_MINS=5
ZAP_MAX_SCAN_DURATION_MINS=60

# Split the ZAP active scan into per-category passes. ZAP partitions every
# active-scan rule into five policy categories, so that is the natural unit —
# no custom rule lists, and set_enabled_policies gates them directly.
#
# WHY: a monolithic active scan is all-or-nothing. DomXssScanRule drove ZAP from
# 2.34 to 11.93 GiB in 78 seconds and killed a scan that still had rules left to
# run. Split, one bad category costs one category; each pass banks its findings
# before the next starts. Client Browser runs LAST because it launches a real
# browser and is by far the likeliest to fail.
#
# Set to false for the old single-pass behaviour.
ZAP_ASCAN_SPLIT=true

# Dispatch KB scan recommendations automatically when an agent session ends.
# Off by default: draining the queue launches real scans at real hosts.
AUTO_RUN_RECOMMENDATIONS=false

# Enable the continuous recon agent automatically when an agent session launches.
# Off by default: the recon agent dispatches scans on a timer. Scope enforcement
# still applies at the scanner, so it cannot reach an unauthorized host.
ENABLE_RECON_AGENT_ON_LAUNCH=false

# --- Internal service URLs -------------------------------------------------
# rag-api is TLS-only: it serves HTTPS on 8000 and an http:// request gets an
# empty reply. Getting this wrong is SILENT -- news_agent._emit_webhook and
# other fire-and-forget callers swallow the transport error, so webhooks simply
# never arrive and nothing logs an error. Keep the scheme https.
RAG_API_URL=https://rag-api:8000

# news-runner reaches the LLM through llm_query, which resolves the backend the
# operator selected in Settings -> LLM Tuning (app_settings.llm.*). Pointing
# news-runner straight at OLLAMA_URL fails in any deployment without an
# `ollama` container.
LLM_QUERY_URL=http://llm_query:8002
# Largest selection the News page may enrich in one request; beyond this the
# request is refused with 429 rather than accepted and abandoned.
# 25, not 100: at the current Azure Foundry per-deployment TPM one large
# selection monopolises the quota and 429s the agent sessions.
NEWS_MAX_ENRICH_BATCH=25

# --- Per-consumer models ---------------------------------------------------
# Each LLM consumer can name its own model; empty = the operator's default from
# Settings -> LLM Tuning. News summarisation does not need the frontier model
# the agents use.
NEWS_LLM_MODEL=
# Set BOTH of these to run news enrichment on a LOCAL ollama and keep it off
# the Azure quota completely. Ollama's native /api/generate takes the same
# payload and returns the same {"response": ...}, so no code change is needed:
#   NEWS_LLM_URL=http://host.docker.internal:11434/api/generate
#   NEWS_LLM_MODEL=qwen2.5:14b
NEWS_LLM_URL=

# --- Azure 429 backoff (llm_query chokepoint) ------------------------------
# Foundry quota is per-deployment TPM. A burst returns RateLimitReached; these
# control how long llm_query waits it out. Waits honour the provider's
# Retry-After header when it sends one. The AGENTS have a separate governor
# (LLM_RATELIMIT_* below) because they call Azure directly via langchain.
LLM_429_MAX_RETRIES=3
LLM_429_BASE_WAIT=5
LLM_429_MAX_WAIT=60

# --- Agent 429 governor (autogen-agents) -----------------------------------
# The agents do NOT go through llm_query - they reach the provider directly via
# langchain - so they have their own knobs. Referenced by the comment above but
# never actually declared here until now; compose supplies the same defaults, so
# a clean install worked, it just gave the operator no hint these existed.
#   MAX_RETRIES : attempts before the phase degrades to its deterministic summary
#   BASE_WAIT   : first wait in seconds; doubles each retry (5,10,20,40...)
#   MAX_WAIT    : ceiling per wait, AND the cap on adaptive pacing
#   ADAPTIVE    : self-tune spacing to observed 429s; decays to zero when healthy
LLM_RATELIMIT_MAX_RETRIES=4
LLM_RATELIMIT_BASE_WAIT=5
LLM_RATELIMIT_MAX_WAIT=60
LLM_RATELIMIT_ADAPTIVE=true
